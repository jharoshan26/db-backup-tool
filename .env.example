# ---- Core ----
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
CORS_ORIGINS=http://localhost:5173

# ---- Metadata database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dbtool?schema=public

# ---- Redis (queues + pub/sub) ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Credential envelope encryption ----
# Base64-encoded 32-byte master key (KEK). Generate: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CREDENTIAL_KEY_VERSION=v1

# ---- Storage ----
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3 / MinIO (when STORAGE_DRIVER=s3)
S3_BUCKET=db-backups
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Worker ----
WORKER_CONCURRENCY=3
WORKER_TMP_DIR=/tmp/dbtool

# ---- SMTP (optional notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dbtool.local

# ---- Dump/restore binaries (override per image if needed) ----
BIN_MYSQLDUMP=mysqldump
BIN_MYSQL=mysql
BIN_PG_DUMP=pg_dump
BIN_PSQL=psql
